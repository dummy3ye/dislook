{
  "name": "dislook",
  "version": "1.1.3",
  "description": "Inspect discord id's snowflakes from the terminal",
  "type": "module",
  "bin": {
    "dislook": "dist/dislook.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "discord",
    "snowflake",
    "cli",
    "id"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsup src/dislook.ts --format esm --clean --out-dir dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "prepublishOnly": "npm run check && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "tsup": "^8",
    "typescript": "^7",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dummy3ye/dislook.git"
  },
  "homepage": "https://github.com/dummy3ye/dislook#readme",
  "bugs": {
    "url": "https://github.com/dummy3ye/dislook/issues"
  }
}
